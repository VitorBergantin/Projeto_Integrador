def obtem_conexao(servidor, usuario, senha, bd):
    if not hasattr(obtem_conexao, 'conexao') or obtem_conexao.conexao is None:
        try:
            obtem_conexao.conexao = connect(
                host=servidor,
                user=usuario,
                password=senha,
                database=bd
            )
        except Error as e:
            print(f"Erro ao conectar ao banco de dados: {e}")
            obtem_conexao.conexao = None
    return obtem_conexao.conexao

