def excluir_dado():
    while True:
        nome = input("Digite o nome de um contato que deseja excluir: ")
        if contatoCadastrado(nome):
            try:
                comando = f"""
                SELECT agua, energia, percentual_reciclado, 
                       transporte_publico, bicicleta, caminhada, carro_combustao, 
                       carro_eletrico, carona_fossil 
                FROM sustentabilidade 
                WHERE nome = '{nome}'
                """
                conexao = obtem_conexao("localhost", "root", "27072006Br", "chacon")
                cursor = conexao.cursor()
                cursor.execute(comando)
                dados = cursor.fetchone()

                if dados:
                    print()
                    print('Consumo de água............:', dados[0], 'litros')
                    print('Consumo de energia.........:', dados[1], 'kWh')
                    print('Percentual reciclado.......:', dados[2], '%')
                    print('Transporte público.........:', dados[3])
                    print('Bicicleta..................:', dados[4])
                    print('Caminhada..................:', dados[5])
                    print('Carro a combustão..........:', dados[6])
                    print('Carro elétrico.............:', dados[7])
                    print('Carona (fóssil)............:', dados[8])

                    confirmacao = input(f"\nDeseja realmente excluir o contato '{nome}'? (s/n): ")
                    if confirmacao.lower() == 's':
                        comando_deletar = f"DELETE FROM sustentabilidade WHERE nome = '{nome}'"
                        cursor.execute(comando_deletar)
                        conexao.commit()
                        print(f"\nContato '{nome}' excluído com sucesso!")
                    else:
                        print('\nExclusão cancelada.')
                else:
                    print("\nRegistro não encontrado.")

                break

            except Error as e:
                print("Problema de conexão com o BD!", e)
                break
        else:
            print("Nome não encontrado. Tente novamente!")
            
