def listagem_dados():
    comando = """
        SELECT nome, agua, energia, percentual_reciclado, transporte_publico, bicicleta, caminhada, carro_combustao,
               carro_eletrico, carona_fossil,     
               CASE
                   WHEN agua < 150 THEN 'Alta Sustentabilidade'
                   WHEN agua BETWEEN 150 AND 200 THEN 'Moderada Sustentabilidade'
                   ELSE 'Baixa Sustentabilidade'
               END AS avaliacao_agua,
               CASE
                   WHEN energia < 5 THEN 'Alta Sustentabilidade'
                   WHEN energia BETWEEN 5 AND 10 THEN 'Moderada Sustentabilidade'
                   ELSE 'Baixa Sustentabilidade'
               END AS avaliacao_energia,
               CASE
                   WHEN percentual_reciclado > 50 THEN 'Alta Sustentabilidade'
                   WHEN percentual_reciclado BETWEEN 20 AND 50 THEN 'Moderada Sustentabilidade'
                   ELSE 'Baixa Sustentabilidade'
               END AS avaliacao_residuos,
               CASE
                   WHEN 
                       (transporte_publico = 'S' OR bicicleta = 'S' OR caminhada = 'S' OR carro_eletrico = 'S') AND 
                       carro_combustao = 'N' AND 
                       carona_fossil = 'N'
                   THEN 'Alta Sustentabilidade'
                   WHEN 
                       (carro_combustao = 'S' OR carona_fossil = 'S') AND 
                       transporte_publico = 'N' AND 
                       bicicleta = 'N' AND 
                       caminhada = 'N' AND 
                       carro_eletrico = 'N'
                   THEN 'Baixa Sustentabilidade'
                   ELSE 'Moderada Sustentabilidade' 
               END AS avaliacao_transporte
        FROM sustentabilidade;
    """

    conexao = obtem_conexao("localhost", "root", "27072006Br", "chacon")
    if conexao is None:
        return []
    
    cursor = conexao.cursor()
    cursor.execute(comando)
    dados = cursor.fetchall()
    conexao.close()
    return dados


def listar_dados():
    try:
        linhas = listagem_dados()
    except Error as e:
        print("Problema de conexão com o BD!", e)
