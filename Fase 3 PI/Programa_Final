def input_transporte(msg):
    while True:
        resposta = input(msg).strip().upper()
        if resposta in ['S', 'N']:
            return resposta
        else:
            print("Entrada inválida! Digite apenas 'S' para sim ou 'N' para não.")




def inserir_dado():
